# Server Configuration
NODE_ENV=production
PORT=3000

# CORS — restrict WebSocket/API access to your domain in production
# ALLOWED_ORIGIN=https://call.yourdomain.com

# Optional: TURN server for users behind strict firewalls/symmetric NATs
# Without a TURN server, calls may fail for ~10-15% of users on restrictive networks.
# You can use Coturn (free, self-hosted) or a managed TURN service.
#
# COTURN_URL=turn:yourdomain.com:3478
# COTURN_USERNAME=airocall_user
# COTURN_CREDENTIAL=your_secure_password
